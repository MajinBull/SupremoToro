# --- Firebase (Auth + Firestore): da Console Firebase → Impostazioni progetto → La tua app
# Se mancano, il pulsante Accedi non viene mostrato finché non configuri.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Firestore consigliato: collection users/{uid}
# Regole minime:
# match /users/{userId} {
#   allow read, write: if request.auth != null && request.auth.uid == userId;
# }

# Produzione su Vercel (root repo): lascia vuoto → le API sono sullo stesso dominio (/api/...).
# Solo se il backend è su un altro host (es. Render), imposta l'URL senza slash finale:
# VITE_API_BASE=https://tu-backend.onrender.com

# URL canonico del sito (SEO: Open Graph, canonical, JSON-LD). Senza slash finale.
# VITE_SITE_URL=https://www.quota.finance

# Google AdSense — opzionale per il blocco sotto l’header (Annunci → Unità → Display).
# Senza slot il componente non renderizza; lo script in index.html resta per verifica / annunci automatici.
# VITE_ADSENSE_CLIENT=ca-pub-8990391589287773
# VITE_ADSENSE_DISPLAY_SLOT=1234567890
