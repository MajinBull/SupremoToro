# Produzione su Vercel (root repo): lascia vuoto → le API sono sullo stesso dominio (/api/...).
# Solo se il backend è su un altro host (es. Render), imposta l'URL senza slash finale:
# VITE_API_BASE=https://tu-backend.onrender.com

# Google AdSense — opzionale per il blocco sotto l’header (Annunci → Unità → Display).
# Senza slot il componente non renderizza; lo script in index.html resta per verifica / annunci automatici.
# VITE_ADSENSE_CLIENT=ca-pub-8990391589287773
# VITE_ADSENSE_DISPLAY_SLOT=1234567890
